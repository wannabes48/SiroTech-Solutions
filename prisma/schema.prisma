generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CLIENT
}

enum OrgRole {
  OWNER
  MEMBER
}

enum ProjectStatus {
  PLANNING
  DESIGN
  BUILD
  TESTING
  LIVE
  ON_HOLD
  COMPLETE
}

enum MilestoneStatus {
  UPCOMING
  IN_PROGRESS
  AWAITING_APPROVAL
  APPROVED
  CHANGES_REQUESTED
}

enum FileKind {
  DELIVERABLE
  DOCUMENT
  ASSET
  CONTRACT
}

enum PayMethod {
  STRIPE
  MPESA
  BANK
}

enum TicketStatus {
  OPEN
  WAITING_ON_CLIENT
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum Currency {
  KES
  USD
  CAD
}

model User {
  id             String            @id @default(cuid())
  name           String?
  email          String            @unique
  passwordHash   String?
  role           Role              @default(CLIENT)
  emailVerified  DateTime?
  company        String?
  phone          String?
  createdAt      DateTime          @default(now())
  failedAttempts Int               @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  avatarUrl      String?
  timezone       String            @default("Africa/Nairobi")
  totpSecret     String?
  totpEnabled    Boolean           @default(false)
  memberships    Membership[]
  notifications  Notification[]
  prefs          NotificationPref?
}

model Organization {
  id           String      @id @default(cuid())
  name         String
  billingEmail String?
  taxPin       String?
  address      String?
  country      String?
  currency     Currency    @default(KES)
  members      Membership[]
  invites      Invite[]
  projects     Project[]
  invoices     Invoice[]
  tickets      Ticket[]
  files        FileAsset[]
}

model Membership {
  id     String       @id @default(cuid())
  userId String
  orgId  String
  role   OrgRole      @default(MEMBER)
  user   User         @relation(fields: [userId], references: [id])
  org    Organization @relation(fields: [orgId], references: [id])

  @@unique([userId, orgId])
}

model Invite {
  id          String       @id @default(cuid())
  orgId       String
  email       String
  role        OrgRole      @default(MEMBER)
  tokenHash   String       @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  org         Organization @relation(fields: [orgId], references: [id])
}

model Project {
  id         String        @id @default(cuid())
  orgId      String
  title      String
  summary    String?
  status     ProjectStatus @default(PLANNING)
  startDate  DateTime?
  targetDate DateTime?
  managerId  String?
  org        Organization  @relation(fields: [orgId], references: [id])
  milestones Milestone[]
  updates    Update[]
  files      FileAsset[]
  messages   Message[]
  invoices   Invoice[]
  proposals  Proposal[]
  tickets    Ticket[]
}

model Milestone {
  id           String          @id @default(cuid())
  projectId    String
  title        String
  description  String?
  dueDate      DateTime?
  status       MilestoneStatus @default(UPCOMING)
  order        Int
  approvedById String?
  approvedAt   DateTime?
  feedback     String?
  project      Project         @relation(fields: [projectId], references: [id])
}

model Update {
  id        String   @id @default(cuid())
  projectId String
  authorId  String
  title     String
  body      String   @db.Text
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
}

model FileAsset {
  id           String       @id @default(cuid())
  orgId        String
  projectId    String?
  uploadedById String
  name         String
  key          String
  size         Int
  mime         String
  kind         FileKind     @default(DOCUMENT)
  createdAt    DateTime     @default(now())
  org          Organization @relation(fields: [orgId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])
}

model Message {
  id          String   @id @default(cuid())
  projectId   String
  authorId    String
  body        String   @db.Text
  attachments Json?
  readBy      String[]
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id])
}

model Proposal {
  id           String    @id @default(cuid())
  projectId    String
  title        String
  fileId       String?
  amount       Int
  currency     Currency
  status       String    @default("SENT")
  acceptedById String?
  acceptedAt   DateTime?
  project      Project   @relation(fields: [projectId], references: [id])
}

model Invoice {
  id           String       @id @default(cuid())
  number       String       @unique
  orgId        String
  projectId    String?
  items        Json
  subtotal     Int
  tax          Int
  total        Int
  amount       Int
  currency     Currency
  status       String       // DRAFT|SENT|PAID|OVERDUE
  dueAt        DateTime
  paidAt       DateTime?
  stripeId     String?
  mpesaReceipt String?
  org          Organization @relation(fields: [orgId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])
  payments     Payment[]
}

model Payment {
  id        String    @id @default(cuid())
  invoiceId String
  method    PayMethod
  amount    Int
  currency  Currency
  reference String?
  status    String
  createdAt DateTime  @default(now())
  invoice   Invoice   @relation(fields: [invoiceId], references: [id])
}

model Ticket {
  id         String        @id @default(cuid())
  orgId      String
  projectId  String?
  category   String        @default("GENERAL")
  priority   String        @default("MEDIUM")
  assigneeId String?
  subject    String
  body       String        @db.Text
  status     TicketStatus  @default(OPEN)
  createdAt  DateTime      @default(now())
  org        Organization  @relation(fields: [orgId], references: [id])
  project    Project?      @relation(fields: [projectId], references: [id])
  replies    TicketReply[]
}

model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String   @db.Text
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
}

model NotificationPref {
  userId        String  @id
  emailMessages Boolean @default(true)
  emailInvoices Boolean @default(true)
  emailUpdates  Boolean @default(true)
  emailTickets  Boolean @default(true)
  user          User    @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())
}

model Service {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  summary      String
  intro        String   @db.Text
  icon         String
  deliverables String[]
  faqs         Json
  order        Int
  published    Boolean  @default(true)
  seoTitle     String?
  seoDesc      String?
}

model Solution {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  blurb     String
  body      String   @db.Text
  modules   String[]
  published Boolean  @default(true)
}

model Industry {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  blurb     String
  body      String   @db.Text
  published Boolean  @default(true)
}

model CaseStudy {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  client        String?
  industryId    String?
  year          Int
  summary       String
  body          String   @db.Text
  cover         String
  gallery       String[]
  metrics       Json
  tech          String[]
  testimonialId String?
  published     Boolean  @default(false)
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  body        String    @db.Text
  cover       String?
  categoryId  String
  authorId    String
  tags        String[]
  readingMins Int
  publishedAt DateTime?
  seoTitle    String?
  seoDesc     String?
}

model Category {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  posts Post[]
}

model Testimonial {
  id       String  @id @default(cuid())
  name     String
  role     String
  company  String
  quote    String
  rating   Int     @default(5)
  avatar   String?
  featured Boolean @default(false)
}

model TeamMember {
  id    String @id @default(cuid())
  name  String
  title String
  bio   String
  photo String
  order Int
}

model Plan {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String
  features    String[]
  highlighted Boolean  @default(false)
  prices      Json
  interval    String
  order       Int
}

model Lead {
  id         String     @id @default(cuid())
  name       String
  company    String?
  email      String
  phone      String?
  need       String
  budget     String
  message    String     @db.Text
  status     LeadStatus @default(NEW)
  source     String?
  timeline   String?
  siteUrl    String?
  transcript Json?
  notes      String?
  createdAt  DateTime   @default(now())
}

model Consultation {
  id       String   @id @default(cuid())
  name     String
  email    String
  startsAt DateTime
  topic    String?
}

model Subscriber {
  id        String  @id @default(cuid())
  email     String  @unique
  confirmed Boolean @default(false)
}

model Job {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  type         String
  location     String
  description  String        @db.Text
  requirements String[]
  open         Boolean       @default(true)
  applications Application[]
}

model Application {
  id        String   @id @default(cuid())
  jobId     String
  name      String
  email     String
  cvUrl     String
  message   String?
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id])
}

model Setting {
  key   String @id
  value Json
}
