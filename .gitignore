# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases

# Next.js build output
/.next/
/out/
/build
/dist

# Production artifacts & caches
*.tsbuildinfo
.turbo/
.cache/

/supabase

# Environment variables & local secrets
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
# Do not ignore example environment files
!.env.example
!.env.local.example

# Debug and runtime logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Diagnostic & test coverage
/coverage/
/.nyc_output/

# Local databases (SQLite, etc.)
*.db
*.db-journal
*.sqlite

# Vercel deployment artifacts
.vercel/

# OS metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor settings
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
