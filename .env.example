# -----------------------------------------------------------------------------
# SiroTech Solutions - Environment Variables for Vercel Deployment
# -----------------------------------------------------------------------------

# Primary Site URL
NEXT_PUBLIC_SITE_URL=https://sirotech.vercel.app

# Anthropic Claude API (Site Assistant)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ASSISTANT_MODEL=claude-haiku-4-5-20251001
ASSISTANT_DAILY_TOKENS=500000

# Upstash Redis (Optional: distributed rate limiting & token spend tracking)
# UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Cloudflare Turnstile (Optional: anti-bot form protection)
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Database URL (Optional: Prisma Postgres for lead persistence)
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Supabase (Optional: Client portal authentication)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
