# -----------------------------------------------------------------------------
# SiroTech Solutions - Environment Variables for Vercel Deployment
# -----------------------------------------------------------------------------

# Primary Site URL
NEXT_PUBLIC_SITE_URL=https://sirotech.vercel.app

# Subdomain routing (middleware.ts + lib/hosts.ts)
#   production: sirotech.co.ke   staging: staging.sirotech.co.ke   local dev: localhost:3000
#   (local: http://portal.localhost:3000 and http://admin.localhost:3000, no hosts-file edits needed)
NEXT_PUBLIC_ROOT_DOMAIN=sirotech.co.ke
# Optional overrides; default to https://portal.<root> and https://admin.<root>
# (or http:// when the root is localhost). Leave both unset in local dev.
NEXT_PUBLIC_PORTAL_URL=https://portal.sirotech.co.ke
NEXT_PUBLIC_ADMIN_URL=https://admin.sirotech.co.ke

# Session signing secret (must be set in production; shared by middleware and server actions)
SESSION_SECRET=generate-a-long-random-string

# Anthropic Claude API (Site Assistant)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ASSISTANT_MODEL=claude-haiku-4-5-20251001
ASSISTANT_DAILY_TOKENS=500000

# Upstash Redis (Optional: distributed rate limiting & token spend tracking)
# UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Cloudflare Turnstile (Optional: anti-bot form protection)
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Database URL (Optional: Prisma Postgres for lead persistence)
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Supabase (Optional: Client portal authentication)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
